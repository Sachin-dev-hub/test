student-registration application in K8s
deployment file: application.yaml and database.yaml
> create namspace:
# kubectl create ns student-devops

> Create the database Secret
root@escbash-lab:~/student# python3 -c "import secrets; print('DB_PASSWORD=' + secrets.token_hex(24))" > .env
chmod 600 .env
root@escbash-lab:~/student# kubectl -n student-devops create secret generic database-secret   --from-env-file=.env
secret/database-secret created
root@escbash-lab:~/student# kubectl get secret -n student-devops 
NAME              TYPE     DATA   AGE
database-secret   Opaque   1      40s
root@escbash-lab:~/student# 


> deploy database

root@escbash-lab:~/student# ls
